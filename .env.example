# Database Connection String for MySQL
DATABASE_URL="mysql://root:password@localhost:3306/shopmaster"

# NextAuth / Security Secret
NEXTAUTH_SECRET="your-super-secret-key-change-in-production"

# WhatsApp Business API / Helper Configurations
WHATSAPP_API_URL="https://graph.facebook.com/v18.0/YOUR_PHONE_NUMBER_ID/messages"
WHATSAPP_API_TOKEN="your_whatsapp_api_bearer_token_here"

# Vercel Cron Security Secret (accepts CRON_SECRET or WHATSAPP_CRON_SECRET)
CRON_SECRET="your_secure_cron_secret_token_here"
WHATSAPP_CRON_SECRET="your_secure_cron_secret_token_here"
