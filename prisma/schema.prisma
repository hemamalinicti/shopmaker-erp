generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  phone        String?
  passwordHash String
  role         String   @default("CASHIER")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([email])
}

model ShopSettings {
  id                  String   @id @default(cuid())
  shopName            String
  ownerName           String
  ownerPhone          String
  ownerWhatsAppNumber String?
  dailyReportEnabled  Boolean  @default(true)
  dailyReportTime     String   @default("21:00")
  address             String
  gstNumber           String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

model DailyReportLog {
  id         String   @id @default(cuid())
  reportDate String   @unique
  status     String   @default("PENDING")
  sentAt     DateTime @default(now())
  messageId  String?
  details    String?

  @@index([reportDate])
}

model Product {
  id            String     @id @default(cuid())
  name          String
  category      String
  purchasePrice Float
  sellingPrice  Float
  gstRate       Float      @default(0.00)
  stockQuantity Int        @default(0)
  lowStockLimit Int        @default(5)
  isActive      Boolean    @default(true)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  billItems     BillItem[]

  @@index([name])
  @@index([category])
  @@index([isActive])
}

model Customer {
  id        String   @id @default(cuid())
  name      String
  phone     String   @unique
  email     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  bills     Bill[]

  @@index([phone])
}

model Bill {
  id            String     @id @default(cuid())
  invoiceNumber String     @unique
  customerId    String?
  customer      Customer?  @relation(fields: [customerId], references: [id], onDelete: SetNull)
  billType      String     @default("GST")
  subtotal      Float
  gstAmount     Float
  totalAmount   Float
  profitAmount  Float
  createdAt     DateTime   @default(now())
  billItems     BillItem[]

  @@index([customerId])
  @@index([createdAt])
}

model BillItem {
  id            String   @id @default(cuid())
  billId        String
  bill          Bill     @relation(fields: [billId], references: [id], onDelete: Cascade)
  productId     String
  product       Product  @relation(fields: [productId], references: [id])
  quantity      Int
  purchasePrice Float
  sellingPrice  Float
  gstRate       Float
  total         Float
  profit        Float

  @@index([billId])
  @@index([productId])
}

model Expense {
  id          String   @id @default(cuid())
  category    String
  description String
  amount      Float
  expenseDate DateTime @default(now())
  createdAt   DateTime @default(now())

  @@index([expenseDate])
  @@index([category])
}
