generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  OWNER
  CASHIER
}

enum BillType {
  GST
  NON_GST
}

enum ExpenseCategory {
  CURRENT
  EB
  SALARY
  OTHER
}

enum DailyReportStatus {
  PENDING
  SENT
  FAILED
  SIMULATED
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  phone        String?
  passwordHash String
  role         Role     @default(CASHIER)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([email])
}

model ShopSettings {
  id                  String   @id @default(cuid())
  shopName            String
  ownerName           String
  ownerPhone          String
  ownerWhatsAppNumber String?
  dailyReportEnabled  Boolean  @default(true)
  dailyReportTime     String   @default("21:00")
  address             String   @db.Text
  gstNumber           String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

model DailyReportLog {
  id         String            @id @default(cuid())
  reportDate String            @unique
  status     DailyReportStatus @default(PENDING)
  sentAt     DateTime          @default(now())
  messageId  String?
  details    String?           @db.Text

  @@index([reportDate])
}

model Product {
  id            String     @id @default(cuid())
  name          String
  category      String
  purchasePrice Decimal    @db.Decimal(12, 2)
  sellingPrice  Decimal    @db.Decimal(12, 2)
  gstRate       Decimal    @default(0.00) @db.Decimal(5, 2)
  stockQuantity Int        @default(0)
  lowStockLimit Int        @default(5)
  isActive      Boolean    @default(true)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  billItems     BillItem[]

  @@index([name])
  @@index([category])
  @@index([isActive])
}

model Customer {
  id        String   @id @default(cuid())
  name      String
  phone     String   @unique
  email     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  bills     Bill[]

  @@index([phone])
}

model Bill {
  id            String     @id @default(cuid())
  invoiceNumber String     @unique
  customerId    String?
  customer      Customer?  @relation(fields: [customerId], references: [id], onDelete: SetNull)
  billType      BillType   @default(GST)
  subtotal      Decimal    @db.Decimal(12, 2)
  gstAmount     Decimal    @db.Decimal(12, 2)
  totalAmount   Decimal    @db.Decimal(12, 2)
  profitAmount  Decimal    @db.Decimal(12, 2)
  createdAt     DateTime   @default(now())
  billItems     BillItem[]

  @@index([customerId])
  @@index([createdAt])
}

model BillItem {
  id            String   @id @default(cuid())
  billId        String
  bill          Bill     @relation(fields: [billId], references: [id], onDelete: Cascade)
  productId     String
  product       Product  @relation(fields: [productId], references: [id])
  quantity      Int
  purchasePrice Decimal  @db.Decimal(12, 2)
  sellingPrice  Decimal  @db.Decimal(12, 2)
  gstRate       Decimal  @db.Decimal(5, 2)
  total         Decimal  @db.Decimal(12, 2)
  profit        Decimal  @db.Decimal(12, 2)

  @@index([billId])
  @@index([productId])
}

model Expense {
  id          String          @id @default(cuid())
  category    ExpenseCategory
  description String
  amount      Decimal         @db.Decimal(12, 2)
  expenseDate DateTime        @default(now())
  createdAt   DateTime        @default(now())

  @@index([expenseDate])
  @@index([category])
}
